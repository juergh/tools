#!/usr/bin/env python3
"""
Export a pass (passwordstore.org) repository as a stream of JSON Lines.

Every entry is decrypted and written as a single-line JSON object (one
entry per line) as soon as it is processed, so the output can be piped
into 'pass-import' without buffering the whole store in memory.
"""

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Optional, TextIO, Tuple


def check_pass_installed() -> bool:
    """Ensure the 'pass' executable is accessible in the PATH."""
    try:
        subprocess.run(
            ["pass", "version"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=True,
        )
        return True
    except (subprocess.CalledProcessError, FileNotFoundError):
        return False


def get_pass_directory(custom_path: Optional[str] = None) -> Path:
    """Determine the location of the password store directory."""
    if custom_path:
        path = Path(custom_path).expanduser()
    else:
        env_dir = os.environ.get("PASSWORD_STORE_DIR")
        path = Path(env_dir).expanduser() if env_dir else Path.home() / ".password-store"

    if not path.is_dir():
        raise FileNotFoundError(f"Password store directory not found at: {path}")
    return path


def decrypt_entry(entry_name: str) -> Optional[str]:
    """Decrypt a pass entry using the pass CLI binary."""
    try:
        result = subprocess.run(
            ["pass", "show", entry_name],
            capture_output=True,
            text=True,
            check=True,
        )
        return result.stdout
    except subprocess.CalledProcessError as e:
        print(f"[!] Warning: Failed to decrypt '{entry_name}': {e.stderr.strip()}", file=sys.stderr)
        return None


def parse_entry_content(content: str) -> Tuple[str, str]:
    """Extract the first line as password and treat all remaining lines as notes."""
    lines = content.splitlines()
    password = lines[0] if lines else ""
    notes = "\n".join(lines[1:]).strip() if len(lines) > 1 else ""
    return password, notes


def export_store(
    store_dir: Path,
    out: TextIO,
    mask_passwords: bool = False,
    verbose: bool = False,
) -> Tuple[int, int]:
    """Traverse the store directory, decrypt all .gpg files and emit them immediately."""
    exported = 0
    failed = 0

    for root, dirs, files in os.walk(store_dir):
        # Skip git repository metadata
        if ".git" in dirs:
            dirs.remove(".git")

        for file in files:
            if not file.endswith(".gpg"):
                continue

            full_path = Path(root) / file
            entry_name = str(full_path.relative_to(store_dir).with_suffix(""))

            if verbose:
                print(f"Decrypting: {entry_name}", file=sys.stderr)

            raw_content = decrypt_entry(entry_name)
            if raw_content is None:
                failed += 1
                continue

            password_val, notes = parse_entry_content(raw_content)
            record = {
                "path": entry_name,
                "password": "*****" if mask_passwords else password_val,
                "notes": notes,
            }
            out.write(json.dumps(record, ensure_ascii=False) + "\n")
            out.flush()
            exported += 1

    return exported, failed


def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Export a pass (passwordstore.org) repository as a stream of "
            "JSON Lines (one entry per line)."
        )
    )
    parser.add_argument(
        "-o",
        "--output",
        type=str,
        help="Path to output file. Output to stdout if omitted.",
    )
    parser.add_argument(
        "-d",
        "--dir",
        type=str,
        help="Custom path to password store directory (defaults to $PASSWORD_STORE_DIR or ~/.password-store).",
    )
    parser.add_argument(
        "--mask",
        action="store_true",
        help="Mask password values (replaces plain text with '*****').",
    )
    parser.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="Print processing progress to stderr.",
    )

    args = parser.parse_args()

    if not check_pass_installed():
        print("Error: 'pass' binary is not installed or not available in PATH.", file=sys.stderr)
        return 1

    try:
        store_dir = get_pass_directory(args.dir)
    except FileNotFoundError as e:
        print(f"Error: {e}", file=sys.stderr)
        return 1

    try:
        if args.output:
            out_path = Path(args.output).expanduser()
            with open(out_path, "w", encoding="utf-8") as f:
                exported, failed = export_store(store_dir, f, args.mask, args.verbose)
        else:
            exported, failed = export_store(store_dir, sys.stdout, args.mask, args.verbose)
    except BrokenPipeError:
        return 1

    destination = f" to {args.output}" if args.output else ""
    failed_part = f" ({failed} failed)" if failed else ""
    print(f"Successfully exported {exported} entries{failed_part}{destination}", file=sys.stderr)

    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
