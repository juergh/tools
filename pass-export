#!/usr/bin/env python3
"""
Export a pass (passwordstore.org) repository into a JSON file.
"""

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any, Dict, List, Optional


def check_pass_installed() -> bool:
    """Ensure the 'pass' executable is accessible in the PATH."""
    try:
        subprocess.run(
            ["pass", "version"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=True,
        )
        return True
    except (subprocess.CalledProcessError, FileNotFoundError):
        return False


def get_pass_directory(custom_path: Optional[str] = None) -> Path:
    """Determine the location of the password store directory."""
    if custom_path:
        path = Path(custom_path).expanduser()
    else:
        env_dir = os.environ.get("PASSWORD_STORE_DIR")
        path = Path(env_dir).expanduser() if env_dir else Path.home() / ".password-store"

    if not path.is_dir():
        raise FileNotFoundError(f"Password store directory not found at: {path}")
    return path


def decrypt_entry(entry_name: str) -> Optional[str]:
    """Decrypt a pass entry using the pass CLI binary."""
    try:
        result = subprocess.run(
            ["pass", "show", entry_name],
            capture_output=True,
            text=True,
            check=True,
        )
        return result.stdout
    except subprocess.CalledProcessError as e:
        print(f"[!] Warning: Failed to decrypt '{entry_name}': {e.stderr.strip()}", file=sys.stderr)
        return None


def parse_entry_content(content: str) -> Dict[str, str]:
    """
    Extract first line as password and treat all remaining lines as raw notes.
    """
    lines = content.splitlines()
    password = lines[0] if lines else ""
    notes = "\n".join(lines[1:]).strip() if len(lines) > 1 else ""

    return {
        "password": password,
        "notes": notes,
    }


def export_store(
    store_dir: Path, mask_passwords: bool = False, verbose: bool = False
) -> List[Dict[str, Any]]:
    """Traverse the store directory and decrypt all .gpg files."""
    entries: List[Dict[str, Any]] = []

    for root, dirs, files in os.walk(store_dir):
        # Skip git repository metadata
        if ".git" in dirs:
            dirs.remove(".git")

        for file in files:
            if file.endswith(".gpg"):
                full_path = Path(root) / file
                rel_path = full_path.relative_to(store_dir)
                entry_name = str(rel_path.with_suffix(""))

                if verbose:
                    print(f"Decrypting: {entry_name}", file=sys.stderr)

                raw_content = decrypt_entry(entry_name)
                if raw_content is None:
                    continue

                parsed = parse_entry_content(raw_content)
                password_val = "*****" if mask_passwords else parsed["password"]

                entries.append(
                    {
                        "path": entry_name,
                        "password": password_val,
                        "notes": parsed["notes"],
                    }
                )

    return entries


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Export a pass (passwordstore.org) database into structured JSON."
    )
    parser.add_argument(
        "-o",
        "--output",
        type=str,
        help="Path to output JSON file. Output to stdout if omitted.",
    )
    parser.add_argument(
        "-d",
        "--dir",
        type=str,
        help="Custom path to password store directory (defaults to $PASSWORD_STORE_DIR or ~/.password_store).",
    )
    parser.add_argument(
        "--mask",
        action="store_true",
        help="Mask password values (replaces plain text with '*****').",
    )
    parser.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="Print processing progress to stderr.",
    )
    parser.add_argument(
        "--compact",
        action="store_true",
        help="Minify JSON output without indentation.",
    )

    args = parser.parse_args()

    if not check_pass_installed():
        print("Error: 'pass' binary is not installed or not available in PATH.", file=sys.stderr)
        sys.exit(1)

    try:
        store_dir = get_pass_directory(args.dir)
    except FileNotFoundError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

    entries = export_store(store_dir, mask_passwords=args.mask, verbose=args.verbose)
    indent = None if args.compact else 2
    json_output = json.dumps(entries, indent=indent, ensure_ascii=False)

    if args.output:
        out_path = Path(args.output).expanduser()
        with open(out_path, "w", encoding="utf-8") as f:
            f.write(json_output)
        print(f"Successfully exported {len(entries)} entries to {out_path}", file=sys.stderr)
    else:
        print(json_output)


if __name__ == "__main__":
    main()
