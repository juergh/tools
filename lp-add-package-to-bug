#!/usr/bin/env python3

import argparse
from launchpadlib.launchpad import Launchpad


def add_packages_to_bug(bug_id: int, package_names: list[str]):
    # Authenticate with Launchpad (opens browser for authorization on first run)
    lp = Launchpad.login_with("tools", "production", version="devel")

    # Fetch the bug and distribution target
    bug = lp.bugs[bug_id]
    distro = lp.distributions["ubuntu"]

    # Process each package
    for package_name in package_names:
        try:
            source_package = distro.getSourcePackage(name=package_name)
            bug.addTask(target=source_package)
            print(f"Successfully added '{package_name}' to Bug #{bug_id}")
        except Exception as err:
            print(f"Failed to add '{package_name}': {err}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Add a source package to a Launchpad bug report."
    )
    parser.add_argument("bug_id", type=int, help="The Launchpad bug ID number (e.g. 123456)")
    parser.add_argument("packages", type=str, nargs="+", help="One or more source package names")

    args = parser.parse_args()
    add_packages_to_bug(args.bug_id, args.packages)
