#!/bin/bash -eu
#
# Download kernel source packages from a PPA
#

function out()
{
	local rc=$?

	if [ "${rc}" -ne 0 ] ; then
		echo "Script failed" >&2
	fi
}

function move_and_link_orig() {
	local orig=${1}
	local real_orig=../orig-tarballs/linux_${orig#*_}

	if [ -f "${orig}" ] ; then
		if [ -e "${real_orig}" ] ; then
			rm "${orig}"
		else
			mv "${orig}" "${real_orig}"
		fi
	fi
	if ! [ -e "${orig}" ] && [ -e "${real_orig}" ] ; then
		ln -s "${real_orig}" "${orig}"
	fi
}

function usage()
{
	cat <<EOF
Usage: cranky-pull-sources [-h] ABI

Download kernel source packages.

Positional arguments:
  ABI         Get the package version from the changelogs using
              the newest changelog entry with abi number ABI.

Optional arguments:
  -h, --help  Show this help text and exit.
EOF
}

CRANKY=${CRANKY:-cranky}

abi=

while [ ${#} -gt 0 ] ; do
	case "${1}" in
		-h|--help)
			usage
			exit
			;;
		*)
			if [ -z "${abi}" ] ; then
				abi=${1}
			else
				echo "Invalid argument: ${1}" >&2
				exit 2
			fi
			;;
	esac
	shift
done

if [ -z "${abi}" ] ; then
	usage
	exit 2
fi

trap out EXIT INT TERM HUP

# Walk through the package set
use_series=0
while read -r path ; do
	(
		cd "${path}"

		if [ -e debian/debian.env ] ; then
			# shellcheck disable=SC1091
			. debian/debian.env
			changelog=${DEBIAN}/changelog
			main=1
		else
			changelog=debian/changelog
			main=0
		fi

		m=$(grep '^linux' "${changelog}" | grep -m1 -F -e " (${abi}" -e " (${abi//-/.}" || true)
		if [ -z "${m}" ] ; then
			echo "EE: No package version found with ABI: ${abi}" >&2
			exit 1
		fi
		read -r package version series _ <<< "${m}"
		version=${version//[()]/}
		series=${series//;/}

		orig=${package}_${version%%-*}.orig.tar.gz

		# Download the source package into the parent directory
		cd ..

		if [ ${main} -eq 1 ] ; then
			move_and_link_orig "${orig}"
		fi

		if [ "${use_series}" -eq 0 ] ; then
			if ! "${CRANKY}" pull-source "${package}" "${version}" ; then
				use_series=1
			fi
		fi

		if [ "${use_series}" -eq 1 ] ; then
			"${CRANKY}" pull-source "${package}" "${version}" "${series}"
		fi

		if [ ${main} -eq 1 ] ; then
			move_and_link_orig "${orig}"
		fi
	)
done < <("${CRANKY}" shell-helper source-packages-path)
