#!/usr/bin/env python3
"""
Import credentials into a pass (passwordstore.org) repository from JSON.

Supported input formats:
  - JSON Lines stream (one line per pass entry: {path, password, notes}) -
    parsed and imported incrementally
  - Aegis Authenticator export (decrypted JSON)
  - Proton Pass export (decrypted JSON)
"""

import argparse
import json
import os
import re
import subprocess
import sys
from itertools import chain
from pathlib import Path
from typing import Any, Dict, Iterator, List, Optional, TextIO, Tuple


def check_pass_installed() -> bool:
    """Ensure the 'pass' executable is accessible in the PATH."""
    try:
        subprocess.run(
            ["pass", "version"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=True,
        )
        return True
    except (subprocess.CalledProcessError, FileNotFoundError):
        return False


def get_pass_directory(custom_path: Optional[str] = None) -> Path:
    """Determine the location of the password store directory."""
    if custom_path:
        path = Path(custom_path).expanduser()
    else:
        env_dir = os.environ.get("PASSWORD_STORE_DIR")
        path = Path(env_dir).expanduser() if env_dir else Path.home() / ".password-store"

    if not path.is_dir():
        raise FileNotFoundError(f"Password store directory not found at: {path}")
    return path


def sanitize_segment(segment: str) -> str:
    """Sanitize a path component by replacing slashes and invalid characters."""
    # Replace slashes and backslashes with dashes
    cleaned = re.sub(r"[/\\]+", "-", segment).strip()
    # Remove leading dots or dashes
    cleaned = re.sub(r"^[.-]+", "", cleaned)
    # Remove trailing dots or dashes
    cleaned = re.sub(r"[.-]+$", "", cleaned)
    return cleaned or "unnamed"


class ItemToImport:
    def __init__(self, path: str, password: str = "", notes: str = "") -> None:
        self.path = path.strip("/")
        self.password = password
        self.notes = notes

    def full_content(self) -> str:
        if self.notes:
            return f"{self.password}\n{self.notes}\n"
        return f"{self.password}\n"


def iter_ndjson_items(
    source: TextIO,
    first_line: str,
    prefix: str = "",
    parse_errors: Optional[List[str]] = None,
) -> Iterator[ItemToImport]:
    """Yield items from a JSON Lines stream, parsing one line at a time."""
    if parse_errors is None:
        parse_errors = []

    for line in chain((first_line,), source):
        stripped = line.strip()
        if not stripped:
            continue

        try:
            obj = json.loads(stripped)
        except json.JSONDecodeError as e:
            msg = f"skipping malformed line: {e}"
            parse_errors.append(msg)
            print(f"[!] Warning: {msg}", file=sys.stderr)
            continue

        if not isinstance(obj, dict) or not isinstance(obj.get("path"), str):
            msg = "skipping line: expected a JSON object with a 'path' key"
            parse_errors.append(msg)
            print(f"[!] Warning: {msg}", file=sys.stderr)
            continue

        path = obj["path"].strip("/")
        if prefix:
            path = f"{prefix.strip('/')}/{path}"

        yield ItemToImport(
            path=path,
            password=str(obj.get("password") or ""),
            notes=str(obj.get("notes") or ""),
        )


def iter_aegis_items(
    data: dict,
    prefix_override: Optional[str] = None,
) -> Iterator[ItemToImport]:
    """Yield items parsed from an Aegis Authenticator export."""
    prefix = prefix_override if prefix_override is not None else "totp"
    seen_paths: Dict[str, int] = {}

    for entry in data.get("entries", []):
        issuer = (entry.get("issuer") or "").strip()
        name = (entry.get("name") or "").strip()
        info = entry.get("info") or {}
        secret = (info.get("secret") or "").strip()

        # Build relative path
        name_seg = sanitize_segment(name) if name else "unnamed"
        if issuer:
            issuer_seg = sanitize_segment(issuer)
            base_path = f"{prefix}/{issuer_seg}/{name_seg}" if prefix else f"{issuer_seg}/{name_seg}"
        else:
            base_path = f"{prefix}/{name_seg}" if prefix else name_seg

        # Handle duplicate entry names
        count = seen_paths.get(base_path, 0)
        seen_paths[base_path] = count + 1
        final_path = base_path if count == 0 else f"{base_path} ({count})"

        # Collect additional metadata in notes
        meta_lines: List[str] = []
        entry_type = entry.get("type")
        if entry_type and entry_type != "totp":
            meta_lines.append(f"Type: {entry_type}")
        algo = info.get("algo")
        if algo and algo != "SHA1":
            meta_lines.append(f"Algorithm: {algo}")
        digits = info.get("digits")
        if digits and digits != 6:
            meta_lines.append(f"Digits: {digits}")
        period = info.get("period")
        if period and period != 30:
            meta_lines.append(f"Period: {period}")
        note = entry.get("note")
        if note:
            meta_lines.append(f"Note: {note}")

        yield ItemToImport(path=final_path, password=secret, notes="\n".join(meta_lines))


def iter_protonpass_items(
    data: dict,
    prefix_override: Optional[str] = None,
) -> Iterator[ItemToImport]:
    """Yield items parsed from a Proton Pass export."""
    prefix = prefix_override if prefix_override is not None else "protonpass"
    seen_paths: Dict[str, int] = {}

    for vault_id, vault_data in data.get("vaults", {}).items():
        vault_name = sanitize_segment(vault_data.get("name") or vault_id)

        for item in vault_data.get("items", []):
            item_data = item.get("data", {})
            metadata = item_data.get("metadata", {})
            content = item_data.get("content", {})

            raw_name = metadata.get("name") or "unnamed"
            item_name = sanitize_segment(raw_name)

            if prefix:
                base_path = f"{prefix}/{vault_name}/{item_name}"
            else:
                base_path = f"{vault_name}/{item_name}"

            count = seen_paths.get(base_path, 0)
            seen_paths[base_path] = count + 1
            final_path = base_path if count == 0 else f"{base_path} ({count})"

            note_lines: List[str] = []

            item_username = content.get("itemUsername")
            if item_username:
                note_lines.append(f"username: {item_username}")

            item_email = content.get("itemEmail")
            if item_email:
                note_lines.append(f"email: {item_email}")

            alias_email = item.get("aliasEmail")
            if alias_email:
                note_lines.append(f"alias_email: {alias_email}")

            totp_uri = content.get("totpUri")
            if totp_uri:
                note_lines.append(f"totp: {totp_uri}")

            urls = content.get("urls")
            if isinstance(urls, list):
                for u in urls:
                    if u:
                        note_lines.append(f"url: {u}")
            elif isinstance(urls, str) and urls:
                note_lines.append(f"url: {urls}")

            note = content.get("note")
            if note:
                note_lines.append(f"\n{note}")

            yield ItemToImport(
                path=final_path,
                password=content.get("password") or "",
                notes="\n".join(note_lines).strip(),
            )


def import_item(
    item: ItemToImport,
    store_dir: Path,
    force: bool = False,
    dry_run: bool = False,
) -> Tuple[str, str]:
    """
    Import a single item into pass.
    Returns (status, message) where status is 'add', 'overwrite', 'skip', or 'error'.
    """
    target_file = store_dir / f"{item.path}.gpg"
    exists = target_file.is_file()

    if exists and not force:
        return "skip", f"-- Skip existing: {item.path}"

    action_label = "Overwrite" if exists else "Add"

    if dry_run:
        action = "overwrite" if exists else "add"
        return action, f"-- Would {action_label.lower()}: {item.path}"

    cmd = ["pass", "insert", "--multiline", "--force", item.path]
    try:
        subprocess.run(
            cmd,
            input=item.full_content(),
            text=True,
            capture_output=True,
            check=True,
        )
    except subprocess.CalledProcessError as e:
        err = e.stderr.strip() if e.stderr else str(e)
        return "error", f"-- Error adding {item.path}: {err}"

    action = "overwrite" if exists else "add"
    return action, f"-- {action_label}: {item.path}"


def open_input(path: str) -> TextIO:
    """Open the input file or return stdin for '-'."""
    if path == "-":
        return sys.stdin
    return open(Path(path).expanduser(), "r", encoding="utf-8")


def first_nonempty_line(source: TextIO) -> Optional[str]:
    """Read the first non-empty line from the source."""
    for line in source:
        if line.strip():
            return line
    return None


def classify_input(
    source: TextIO,
    first_line: str,
    args: argparse.Namespace,
    parse_errors: List[str],
) -> Any:
    """
    Classify the input and return an item iterator.

    Defaults to parsing the input line by line when each line is a complete
    JSON object with a 'path' key (JSON Lines stream). Otherwise the input is
    treated as an Aegis or Proton Pass export document.
    """
    doc: Optional[dict] = None

    if args.type == "auto":
        try:
            first_obj: Any = json.loads(first_line)
        except json.JSONDecodeError:
            first_obj = None

        if first_obj is not None:
            if not isinstance(first_obj, dict):
                raise ValueError(
                    "Unsupported JSON input (expected pass entry lines, "
                    "an Aegis or a Proton Pass export)"
                )
            doc = first_obj
        else:
            # Pretty-printed / multi-line document: read it completely
            try:
                raw = first_line + source.read()
                parsed = json.loads(raw)
            except json.JSONDecodeError as e:
                raise ValueError(f"Input is not valid JSON: {e}")
            if not isinstance(parsed, dict):
                raise ValueError(
                    "Unsupported JSON input (expected pass entry lines, "
                    "an Aegis or a Proton Pass export)"
                )
            doc = parsed

        if isinstance(doc.get("path"), str) and "entries" not in doc and "vaults" not in doc:
            return iter_ndjson_items(
                source, first_line, prefix=args.prefix, parse_errors=parse_errors
            )
        if isinstance(doc.get("entries"), list):
            return iter_aegis_items(doc, prefix_override=args.prefix)
        if isinstance(doc.get("vaults"), dict):
            return iter_protonpass_items(doc, prefix_override=args.prefix)
        raise ValueError(
            "Unsupported JSON input (expected pass entry lines, "
            "an Aegis or a Proton Pass export)"
        )
    else:
        # Explicit type: read the whole document
        try:
            parsed = json.loads(first_line + source.read())
        except json.JSONDecodeError as e:
            raise ValueError(f"Input is not valid JSON: {e}")

        key = "entries" if args.type == "aegis" else "vaults"
        if not isinstance(parsed, dict) or not isinstance(parsed.get(key), (list, dict)):
            raise ValueError(f"Input does not look like a {args.type} export")

        if args.type == "aegis":
            return iter_aegis_items(parsed, prefix_override=args.prefix)
        return iter_protonpass_items(parsed, prefix_override=args.prefix)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Import credentials into a pass (passwordstore.org) repository from JSON."
    )
    parser.add_argument(
        "file",
        nargs="?",
        default="-",
        help="Path to JSON file ('-' or omitted for stdin)",
    )
    parser.add_argument(
        "-d",
        "--dir",
        type=str,
        help="Custom path to password store directory (defaults to $PASSWORD_STORE_DIR or ~/.password-store).",
    )
    parser.add_argument(
        "-f",
        "--force",
        action="store_true",
        help="Overwrite existing entries in the password store.",
    )
    parser.add_argument(
        "-n",
        "--dry-run",
        action="store_true",
        help="Preview entries without modifying the password store.",
    )
    parser.add_argument(
        "-p",
        "--prefix",
        type=str,
        help="Custom prefix directory in password store (overrides default 'totp' or 'protonpass').",
    )
    parser.add_argument(
        "-t",
        "--type",
        choices=["auto", "aegis", "protonpass"],
        default="auto",
        help="Format type of input JSON (default: auto).",
    )
    parser.add_argument(
        "-q",
        "--quiet",
        action="store_true",
        help="Quiet mode: do not print individual entry statuses.",
    )

    args = parser.parse_args()

    if not check_pass_installed() and not args.dry_run:
        print("Error: 'pass' binary is not installed or not available in PATH.", file=sys.stderr)
        return 1

    try:
        store_dir = get_pass_directory(args.dir)
    except FileNotFoundError as e:
        if not args.dry_run:
            print(f"Error: {e}", file=sys.stderr)
            return 1
        store_dir = Path("/tmp")

    parse_errors: List[str] = []
    items: Iterator[ItemToImport]

    try:
        source = open_input(args.file)
    except OSError as e:
        print(f"Error reading input: {e}", file=sys.stderr)
        return 1

    with source:
        first_line = first_nonempty_line(source)
        if first_line is None:
            print("Error: Input is empty.", file=sys.stderr)
            return 1

        try:
            items = classify_input(source, first_line, args, parse_errors)
        except ValueError as e:
            print(f"Error: {e}", file=sys.stderr)
            return 1

        added = 0
        overwritten = 0
        skipped = 0
        imported_errors = 0

        try:
            for item in items:
                status, msg = import_item(
                    item,
                    store_dir=store_dir,
                    force=args.force,
                    dry_run=args.dry_run,
                )
                if not args.quiet:
                    print(msg)

                if status == "add":
                    added += 1
                elif status == "overwrite":
                    overwritten += 1
                elif status == "skip":
                    skipped += 1
                elif status == "error":
                    imported_errors += 1
        except BrokenPipeError:
            return 1

    total = added + overwritten + skipped + imported_errors
    error_count = len(parse_errors) + imported_errors
    mode_str = " (dry run)" if args.dry_run else ""
    summary = (
        f"Processed {total} entries{mode_str}: "
        f"{added} added, {overwritten} overwritten, {skipped} skipped"
    )
    if error_count > 0:
        summary += f", {error_count} errors"
    print(summary, file=sys.stderr)

    return 1 if error_count > 0 else 0


if __name__ == "__main__":
    sys.exit(main())
