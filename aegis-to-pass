#!/bin/bash -eu
#
# Read an Aegis backup and add the entries to the password store
#

set -o pipefail

HERE=$(dirname "$(readlink -f "${0}")")

function usage()
{
	cat <<EOF
Usage: $(basename "${0}") [-f] [-n] [-h] INFILE

Read an Aegis backup file and add the entries to the password store.

Optional arguments:
  -f, --force    Overwrite existing entries.
  -n, --dry-run  Simulate import without modifying the password store.
  -h, --help     Show this help text and exit.
EOF
}

flags=()
infile=

while [ $# -ne 0 ] ; do
	case "${1}" in
		-f|--force)
			flags+=("-f")
			;;
		-n|--dry-run)
			flags+=("-n")
			;;
		-h|--help)
			usage
			exit
			;;
		*)
			if [ -n "${infile}" ] ; then
				usage
				exit 2
			fi
			infile=${1}
			;;
	esac
	shift
done

if [ -z "${infile}" ] ; then
	usage
	exit 2
fi

"${HERE}/decrypt-aegis-json" "${infile}" | "${HERE}/pass-import" ${flags[@]+"${flags[@]}"}
